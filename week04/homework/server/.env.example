# HTTP and browser session
PORT=8080
GIN_MODE=debug
AUTO_MIGRATE=true
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL and private Storage
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY
SUPABASE_BUCKET=materials

# OpenAI-compatible model API. Use a model identifier available to your account.
AI_API_KEY=YOUR_MODEL_API_KEY
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=YOUR_AVAILABLE_MODEL_ID

# Windows document tools. Docker uses the paths installed in the image.
TESSERACT_PATH=D:\Tesseract\tesseract.exe
POPPLER_BIN_PATH=D:\Poppler\Library\bin
